# Target Flipkart Product Configuration
PRODUCT_NAME=WOODLAND Slip On Casuals For Men
PRODUCT_COLOR=DNAVY 4
PRODUCT_SIZE=7

# Direct Flipkart Product URL
PRODUCT_URL=https://www.flipkart.com/woodland-slip-lightweight-comfortable-easy-wear-casuals-men/p/itm28c3d46f85a6c?pid=SHOFXHQCVGM4NRCE&marketplace=FLIPKART&lid=LSTSHOFXHQCVGM4NRCENSXFFB&fm=eyJ3dHAiOiJyZWNvIiwicHJwdCI6ImNscCIsIm1pZCI6ImZhY3RCYXNlZFJlY29tbWVuZGF0aW9uL3JlY2VudGx5Vmlld2VkIn0%3D&pageUID=1791787958174

# Dedicated ntfy.sh topic (separate from bms-movie-monitor-alerts so ticket booking is never interrupted)
NTFY_TOPIC=flipkart-woodland-size7-alerts

# Dedicated local server port (3001 so it doesn't collide with BookMyShow on port 3000)
PORT=3001

# Interval between repeated alerts in seconds (default: 2s, e.g. set 1 for every 1s)
ALERT_INTERVAL_SECONDS=2

# Periodic status heartbeat in minutes when product is Out of Stock (1440 mins = 24 hours / once per day, set 0 to disable)
HEARTBEAT_INTERVAL_MINUTES=1440

# Daily time in IST (Asia/Kolkata, 24-hour HH:MM) after which the 1/day Out-of-Stock notification is sent
DAILY_STATUS_TIME=10:30

# Optional: Set to true for headless cloud servers (Render, Railway, VPS)
HEADLESS=true

# Twilio API Credentials (optional, for SMS / WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telegram Bot API Token (optional)
TELEGRAM_BOT_TOKEN=
